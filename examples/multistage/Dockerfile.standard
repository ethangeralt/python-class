# ========================================================
# Standard (Single-Stage) Dockerfile
# ========================================================
# In this approach, the entire Go SDK, compiler, package cache,
# build tools, and source files remain inside the final production image.

FROM golang:1.22-alpine

WORKDIR /app

# Copy dependency definition and source code
COPY go.mod ./
COPY main.go ./

# Compile the application
RUN go build -o server .

# Expose port
EXPOSE 8080

# Run the binary
CMD ["./server"]
